# このファイルを .env にコピーして値を設定する
#   Windows: copy .env.example .env / macOS・Linux: cp .env.example .env

# Supabase Dashboard > Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Dashboard > Settings > API Keys > Legacy anon, service_role API keys > anon public
SUPABASE_ANON_KEY=eyJhbGciOi...

# JWT の検証は通常 JWKS（公開鍵）で自動的に行うため設定不要。
# レガシー（HS256）プロジェクトの場合のみ、JWT Secret を設定する
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 許可するフロントエンドのオリジン（カンマ区切り）。開発中は * でよい。
# 本番では公開先のURLに必ず絞ること（例: https://megapay.example.com）
CORS_ORIGINS=*
